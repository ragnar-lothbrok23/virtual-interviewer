# Copy to .env and fill in. Never commit .env.

# development | testing | production
APP_ENV=development

# Long random string (production requires >= 32 chars):
#   venv\Scripts\python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Database. Leave empty in development to use SQLite (instance/interviewer.db).
# Production: PostgreSQL, e.g. postgresql://user:password@host:5432/interviewer
DATABASE_URL=

# Redis for background jobs + rate limiting. Leave empty in development (a SQLite queue is used).
# Production: redis://host:6379/0
REDIS_URL=

# Set to 1 when running behind a reverse proxy (Caddy/Nginx) so client IPs and HTTPS are detected correctly
TRUST_PROXY=0

# Gemini API key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_EMBED_MODEL=gemini-embedding-2
GEMINI_PARSE_THINKING=LOW

# Resume match score (0-100) at or above which applicants are auto-shortlisted
SHORTLIST_THRESHOLD=60

# Email. gmail_smtp = send through Gmail; console = save to instance/outbox (no sending)
MAIL_BACKEND=console
# Gmail account the system sends from, and its 16-letter app password
# (Google account -> Security -> 2-Step Verification -> App passwords)
MAIL_USERNAME=
MAIL_APP_PASSWORD=
# Development only: deliver every email to this inbox instead of the real recipient. Must be empty in production.
MAIL_REDIRECT_TO=
# Stay under Gmail's ~500 emails/day; extra mail is deferred by an hour
MAIL_DAILY_LIMIT=450
# Public https:// address of the site, used for links in emails
APP_BASE_URL=http://127.0.0.1:5000

LOG_LEVEL=INFO
