<mxfile host="app.diagrams.net"><diagram id="Modules" name="Modules"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1620" pageHeight="770" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="&lt;b&gt;AI Virtual Interviewer: Module Diagram&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;fontSize=22;fillColor=none;strokeColor=none;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="0" y="10" width="1620" height="40" as="geometry"/></mxCell><mxCell id="c2" value="1. User &amp;amp; Access Management" style="swimlane;html=1;startSize=30;rounded=1;arcSize=3;fontStyle=1;fontSize=14;horizontal=1;swimlaneFillColor=#ffffff;collapsible=0;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="50" y="90" width="380" height="230" as="geometry"/></mxCell><mxCell id="c3" value="&amp;#8226;&amp;nbsp; Three roles: Candidate, HR, Admin&lt;br&gt;&amp;#8226;&amp;nbsp; Sign-up with email verification&lt;br&gt;&amp;#8226;&amp;nbsp; Password reset, profile, data export / delete&lt;br&gt;&amp;#8226;&amp;nbsp; Consent before recording and AI analysis&lt;br&gt;&amp;#8226;&amp;nbsp; Email (Gmail) + in-app notifications" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;align=left;verticalAlign=middle;spacingLeft=10;fontSize=14;fillColor=#ffffff;strokeColor=none;fontFamily=Helvetica;" vertex="1" parent="c2"><mxGeometry x="15" y="45" width="350" height="170" as="geometry"/></mxCell><mxCell id="c4" value="2. Job &amp;amp; Resume Screening" style="swimlane;html=1;startSize=30;rounded=1;arcSize=3;fontStyle=1;fontSize=14;horizontal=1;swimlaneFillColor=#ffffff;collapsible=0;fillColor=#d5e8d4;strokeColor=#82b366;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="620" y="90" width="380" height="230" as="geometry"/></mxCell><mxCell id="c5" value="&amp;#8226;&amp;nbsp; HR posts jobs with required skills&lt;br&gt;&amp;#8226;&amp;nbsp; Resume upload (PDF / DOCX), encrypted&lt;br&gt;&amp;#8226;&amp;nbsp; Gemini extracts skills, experience, projects&lt;br&gt;&amp;#8226;&amp;nbsp; Embedding match score (0 to 100)&lt;br&gt;&amp;#8226;&amp;nbsp; Auto-shortlist when score is 60 or more" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;align=left;verticalAlign=middle;spacingLeft=10;fontSize=14;fillColor=#ffffff;strokeColor=none;fontFamily=Helvetica;" vertex="1" parent="c4"><mxGeometry x="15" y="45" width="350" height="170" as="geometry"/></mxCell><mxCell id="c6" value="3. Interview Scheduling" style="swimlane;html=1;startSize=30;rounded=1;arcSize=3;fontStyle=1;fontSize=14;horizontal=1;swimlaneFillColor=#ffffff;collapsible=0;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1190" y="90" width="380" height="230" as="geometry"/></mxCell><mxCell id="c7" value="&amp;#8226;&amp;nbsp; HR publishes interview slots&lt;br&gt;&amp;#8226;&amp;nbsp; Candidate books, reschedules or cancels&lt;br&gt;&amp;#8226;&amp;nbsp; Calendar invite (.ics) by email&lt;br&gt;&amp;#8226;&amp;nbsp; Automatic reminders&lt;br&gt;&amp;#8226;&amp;nbsp; No-show marking" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;align=left;verticalAlign=middle;spacingLeft=10;fontSize=14;fillColor=#ffffff;strokeColor=none;fontFamily=Helvetica;" vertex="1" parent="c6"><mxGeometry x="15" y="45" width="350" height="170" as="geometry"/></mxCell><mxCell id="c8" value="4. Interview Room &amp;amp; Question Engine" style="swimlane;html=1;startSize=30;rounded=1;arcSize=3;fontStyle=1;fontSize=14;horizontal=1;swimlaneFillColor=#ffffff;collapsible=0;fillColor=#e1d5e7;strokeColor=#9673a6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1190" y="430" width="380" height="230" as="geometry"/></mxCell><mxCell id="c9" value="&amp;#8226;&amp;nbsp; Webcam + microphone recording per answer&lt;br&gt;&amp;#8226;&amp;nbsp; Questions from job description and resume&lt;br&gt;&amp;#8226;&amp;nbsp; Speech transcribed by Gemini&lt;br&gt;&amp;#8226;&amp;nbsp; Adaptive follow-up on weak answers&lt;br&gt;&amp;#8226;&amp;nbsp; Time limits, multiple-face integrity flag" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;align=left;verticalAlign=middle;spacingLeft=10;fontSize=14;fillColor=#ffffff;strokeColor=none;fontFamily=Helvetica;" vertex="1" parent="c8"><mxGeometry x="15" y="45" width="350" height="170" as="geometry"/></mxCell><mxCell id="c10" value="5. Answer &amp;amp; Emotion Analysis" style="swimlane;html=1;startSize=30;rounded=1;arcSize=3;fontStyle=1;fontSize=14;horizontal=1;swimlaneFillColor=#ffffff;collapsible=0;fillColor=#f8cecc;strokeColor=#b85450;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="620" y="430" width="380" height="230" as="geometry"/></mxCell><mxCell id="c11" value="&amp;#8226;&amp;nbsp; NLP score: relevance, accuracy, fluency + similarity&lt;br&gt;&amp;#8226;&amp;nbsp; Facial emotion: YuNet + HSEmotion&lt;br&gt;&amp;#8226;&amp;nbsp; Voice emotion: emotion2vec+&lt;br&gt;&amp;#8226;&amp;nbsp; Confidence, engagement, stability&lt;br&gt;&amp;#8226;&amp;nbsp; Consistency check across answers" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;align=left;verticalAlign=middle;spacingLeft=10;fontSize=14;fillColor=#ffffff;strokeColor=none;fontFamily=Helvetica;" vertex="1" parent="c10"><mxGeometry x="15" y="45" width="350" height="170" as="geometry"/></mxCell><mxCell id="c12" value="6. Scorecard &amp;amp; HR Analytics" style="swimlane;html=1;startSize=30;rounded=1;arcSize=3;fontStyle=1;fontSize=14;horizontal=1;swimlaneFillColor=#ffffff;collapsible=0;fillColor=#ffe6cc;strokeColor=#d79b00;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="50" y="430" width="380" height="230" as="geometry"/></mxCell><mxCell id="c13" value="&amp;#8226;&amp;nbsp; Final = 0.75 NLP + 0.15 Emotion + 0.10 Context&lt;br&gt;&amp;#8226;&amp;nbsp; Per-question breakdown with evidence&lt;br&gt;&amp;#8226;&amp;nbsp; Downloadable PDF scorecard&lt;br&gt;&amp;#8226;&amp;nbsp; Dashboard: hiring funnel, score spread&lt;br&gt;&amp;#8226;&amp;nbsp; CSV export" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;align=left;verticalAlign=middle;spacingLeft=10;fontSize=14;fillColor=#ffffff;strokeColor=none;fontFamily=Helvetica;" vertex="1" parent="c12"><mxGeometry x="15" y="45" width="350" height="170" as="geometry"/></mxCell><mxCell id="c14" value="candidate applies" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;fontFamily=Helvetica;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c2" target="c4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c15" value="shortlisted" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;fontFamily=Helvetica;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c4" target="c6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c16" value="interview starts at booked time" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;fontFamily=Helvetica;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c6" target="c8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c17" value="recorded answers" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;fontFamily=Helvetica;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c8" target="c10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c18" value="NLP + emotion + context scores" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;fontFamily=Helvetica;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c10" target="c12"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c19" value="Flow: register → apply → screen → book → interview → analyse → score. HR reviews the result in module 6; notifications from module 1 accompany every step." style="text;html=1;align=center;verticalAlign=middle;fontSize=13;fontColor=#555555;fillColor=none;strokeColor=none;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="50" y="700" width="1520" height="40" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>