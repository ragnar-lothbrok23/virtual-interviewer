ocal ONNX models (run on the server)&lt;/b&gt;&lt;br&gt;YuNet face detector · HSEmotion facial emotion (8 classes)&lt;br&gt;emotion2vec+ voice emotion" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fillColor=#ffffff;strokeColor=#b85450;fontFamily=Helvetica;" vertex="1" parent="c21"><mxGeometry x="30" y="185" width="630" height="115" as="geometry"/></mxCell><mxCell id="c24" value="Data &amp;amp; External Services" style="swimlane;html=1;startSize=30;rounded=1;arcSize=3;fontStyle=1;fontSize=14;horizontal=1;swimlaneFillColor=#ffffff;collapsible=0;fillColor=#f5f5f5;strokeColor=#666666;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="770" y="880" width="690" height="320" as="geometry"/></mxCell><mxCell id="c25" value="&lt;b&gt;Database&lt;/b&gt;&lt;br&gt;SQLite (dev) / PostgreSQL&lt;br&gt;SQLAlchemy + Alembic migrations" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;shape=cylinder3;boundedLbl=1;size=12;fillColor=#ffffff;strokeColor=#666666;fontFamily=Helvetica;" vertex="1" parent="c24"><mxGeometry x="30" y="50" width="300" height="115" as="geometry"/></mxCell><mxCell id="c26" value="&lt;b&gt;Encrypted file storage&lt;/b&gt;&lt;br&gt;Resumes and answer recordings&lt;br&gt;(Fernet encryption at rest)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fillColor=#ffffff;strokeColor=#666666;fontFamily=Helvetica;" vertex="1" parent="c24"><mxGeometry x="360" y="50" width="300" height="115" as="geometry"/></mxCell><mxCell id="c27" value="&lt;b&gt;Gmail SMTP&lt;/b&gt;&lt;br&gt;Verification and password emails · shortlist notices&lt;br&gt;interview invites (.ics) and reminders" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fillColor=#ffffff;strokeColor=#666666;fontFamily=Helvetica;" vertex="1" parent="c24"><mxGeometry x="30" y="185" width="630" height="115" as="geometry"/></mxCell><mxCell id="c28" value="HTTPS" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strok